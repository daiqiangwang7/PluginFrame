        <file alias="icons/theme/light/skin.png">../assets/icons/theme/light/skin.png</file>
        <file alias="icons/window/dark/close.png">../assets/icons/window/dark/close.png</file>
        <file alias="icons/window/dark/maximize.png">../assets/icons/window/dark/maximize.png</file>
        <file alias="icons/window/dark/minimize.png">../assets/icons/window/dark/minimize.png</file>
        <file alias="icons/window/dark/restore.png">../assets/icons/window/dark/restore.png</file>
        <file alias="icons/window/light/close.png">../assets/icons/window/light/close.png</file>
        <file alias="icons/window/light/maximize.png">../assets/icons/window/light/maximize.png</file>
        <file alias="icons/window/light/minimize.png">../assets/icons/window/light/minimize.png</file>
