QWidget {
    background: #EEF8FA;
    color: #12212B;
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 13px;
}

QWidget#ShellRoot {
    background: #F7FCFD;
    border: 1px solid #00A8CC;
}

QWidget#FloatingWindowFrame {
    background: #F7FCFD;
    border: 1px solid #00A8CC;
}

QWidget#Workspace {
    background: #F7FCFD;
    border-top: 1px solid #00A8CC;
}

QFrame#TitleSeparator {
    background: #00A8CC;
    border: none;
    min-height: 2px;
    max-height: 2px;
}

QWidget#CyberDrawer {
    background: #E5F6F9;
    border-left: 1px solid #00A8CC;
    border-top: 1px solid #A7CBD4;
    border-bottom: 1px solid #A7CBD4;
}

QWidget#DrawerContent {
    background: #E5F6F9;
}

QPushButton#DrawerHandleButton {
    background: #F0FBFD;
    border: 1px solid #A7CBD4;
    border-right: none;
    color: #006C82;
    font-size: 18px;
    font-weight: 600;
    padding: 0;
}

QPushButton#DrawerHandleButton:hover {
    background: #CFF0F6;
    border-color: #00A8CC;
    color: #12212B;
}

QPushButton#SidebarButton {
    background: #F0FBFD;
    border: 1px solid #A7CBD4;
    color: #274654;
    text-align: left;
    padding-left: 16px;
}

QPushButton#SidebarButton:hover {
    background: #CFF0F6;
    border-color: #00A8CC;
    color: #006C82;
}

QToolButton#SidebarToolButton {
    background: #F0FBFD;
    border: 1px solid #A7CBD4;
    color: #274654;
    padding: 4px;
}

QToolButton#SidebarToolButton:hover {
    background: #CFF0F6;
    border-color: #00A8CC;
    color: #006C82;
}

QPushButton#DrawerPageButton {
    background: #F0FBFD;
    border: 1px solid #A7CBD4;
    color: #006C82;
    min-width: 26px;
    max-width: 26px;
    min-height: 24px;
    max-height: 24px;
    padding: 0;
}

QLabel#DrawerPageLabel {
    color: #006C82;
    min-width: 42px;
}

QWidget#CyberStatusBar {
    background: #E5F6F9;
    border-top: 1px solid #A7CBD4;
}

QLabel#StatusSummary {
    color: #006C82;
}

QWidget#TitleBar {
    background: #DDF4F8;
    border-bottom: 1px solid #00A8CC;
    min-height: 36px;
    max-height: 36px;
}

QLabel#WindowTitle {
    color: #006C82;
    font-size: 15px;
    font-weight: 600;
}

QPushButton#MinimizeButton,
QPushButton#MaximizeButton,
QPushButton#CloseButton,
QPushButton#ThemeButton {
    background: transparent;
    border: 1px solid transparent;
    color: #12212B;
    min-width: 36px;
    max-width: 36px;
    min-height: 28px;
    max-height: 28px;
    padding: 0;
}

QPushButton#ThemeButton {
    min-width: 32px;
    max-width: 32px;
}

QPushButton#MinimizeButton:hover,
QPushButton#MaximizeButton:hover,
QPushButton#ThemeButton:hover {
    background: #C7EDF4;
    border-color: #00A8CC;
    color: #006C82;
}

QPushButton#CloseButton:hover {
    background: #FF4F8B;
    border-color: #FF4F8B;
    color: #FFFFFF;
}

QTabWidget::pane {
    border: 1px solid #A7CBD4;
    top: -1px;
}

QSplitter::handle {
    background: #B7DDE5;
}

QSplitter::handle:hover {
    background: #00A8CC;
}

QTabBar::tab {
    background: #E7F5F8;
    color: #274654;
    border: 1px solid #A7CBD4;
    padding: 8px 18px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #CFF0F6;
    color: #006C82;
    border-bottom-color: #CFF0F6;
}

QPushButton {
    background: #E4F8FC;
    color: #12212B;
    border: 1px solid #00A8CC;
    padding: 7px 14px;
}

QPushButton:hover {
    background: #D0F2F8;
    border-color: #007C99;
}

QTableWidget {
    background: #F7FCFD;
    alternate-background-color: #EAF7FA;
    gridline-color: #A7CBD4;
    border: 1px solid #A7CBD4;
    selection-background-color: #BDEAF2;
    selection-color: #12212B;
}

QHeaderView::section {
    background: #DDF4F8;
    color: #006C82;
    border: 1px solid #A7CBD4;
    padding: 6px;
}
